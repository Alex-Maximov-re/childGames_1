{
  "name": "luchik",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:android": "vite --config apps/android/vite.config.ts",
    "dev:ios": "vite --config apps/ios/vite.config.ts",
    "build": "npm run build:web && npm run build:android && npm run build:ios",
    "build:web": "tsc --noEmit -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build:pages": "tsc --noEmit -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build:android": "tsc --noEmit -p apps/android/tsconfig.json && vite build --config apps/android/vite.config.ts",
    "build:ios": "tsc --noEmit -p apps/ios/tsconfig.json && vite build --config apps/ios/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "android:sync": "npm run build:android && cd apps/android && npx cap sync",
    "android:open": "cd apps/android && npx cap open android",
    "ios:sync": "npm run build:ios && cd apps/ios && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@fontsource/nunito": "^5.2.5",
    "@fontsource/shantell-sans": "^5.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@capacitor/cli": "^7.4.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
